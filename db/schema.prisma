generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  MEETING_SCHEDULED
  AWAITING_PAYMENT
  PROOF_SUBMITTED
  VERIFIED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageType {
  GENERAL
  APPROVAL
  MEETING
  PAYMENT
  INTERNAL_NOTE
}

enum MeetingType {
  ONLINE
  IN_PERSON
}

enum MeetingStatus {
  SCHEDULED
  ACCEPTED
  RESCHEDULE_REQUESTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  AWAITING_PAYMENT
  PROOF_SUBMITTED
  VERIFIED
  REJECTED
}

enum OtpType {
  PHONE_VERIFY
  PASSWORD_RESET
}

enum NotificationType {
  REQUEST_STATUS
  NEW_MESSAGE
  PAYMENT_DUE
  PAYMENT_VERIFIED
  MEETING
  GENERAL
}

enum ChannelType {
  TELEGRAM
  WHATSAPP
}

model User {
  id                  String         @id @default(uuid())
  name                String
  phone               String         @unique
  email               String?        @unique
  passwordHash        String
  role                Role           @default(CLIENT)
  isActive            Boolean        @default(true)
  isPhoneVerified     Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockoutUntil        DateTime?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  profile             ClientProfile?
  refreshTokens       RefreshToken[]
  requests            ServiceRequest[] @relation("ClientRequests")
  assignedRequests    ServiceRequest[] @relation("StaffAssignedRequests")
  messages            Message[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  channelLinks        ChannelLink[]
  feedbacks           Feedback[]
  attachments         Attachment[]
  verifiedPayments    PaymentRequest[] @relation("VerifiedPayments")

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model OtpCode {
  id           String    @id @default(uuid())
  phoneOrEmail String
  codeHash     String
  type         OtpType
  expiresAt    DateTime
  usedAt       DateTime?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([phoneOrEmail, type])
}

model ClientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  companyName       String?
  address           String?
  city              String?
  telegramUsername  String?
  whatsappPhone     String?
  preferredLanguage String   @default("en")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id           String           @id @default(uuid())
  key          String           @unique
  title        String
  description  String
  icon         String?
  startingPrice Float?
  currency     String           @default("ETB")
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  requests     RequestService[]

  @@index([key])
  @@index([isActive])
}

model ServiceRequest {
  id                   String           @id @default(uuid())
  requestNumber        String           @unique
  clientId             String
  title                String
  description          String
  budgetRange          String?
  preferredContactTime String?
  status               RequestStatus    @default(PENDING)
  priority             Priority         @default(NORMAL)
  assignedStaffId      String?

  aiCategory           String?
  aiPriority           Priority?
  aiSentiment          String?
  aiLanguage           String?
  aiSummary            String?
  aiNextAction         String?

  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  client               User             @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Restrict)
  assignedStaff        User?            @relation("StaffAssignedRequests", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  services             RequestService[]
  attachments          Attachment[]
  messages             Message[]
  meetings             Meeting[]
  paymentRequests      PaymentRequest[]
  feedback             Feedback?

  @@index([requestNumber])
  @@index([clientId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model RequestService {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceId        String

  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, serviceId])
  @@index([serviceRequestId])
  @@index([serviceId])
}

model Attachment {
  id               String          @id @default(uuid())
  serviceRequestId String?
  messageId        String?
  fileName         String
  fileKey          String
  mimeType         String
  fileSize         Int
  uploadedByUserId String?
  createdAt        DateTime        @default(now())

  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  message          Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy       User?           @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  paymentProof     PaymentProof?

  @@index([serviceRequestId])
  @@index([messageId])
}

model Message {
  id               String          @id @default(uuid())
  serviceRequestId String
  senderId         String
  type             MessageType     @default(GENERAL)
  content          String
  metadata         String?         // JSON string for meeting, payment, or approval data
  isReadByClient   Boolean         @default(false)
  isReadByAdmin    Boolean         @default(false)
  createdAt        DateTime        @default(now())

  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  sender           User            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments      Attachment[]
  meeting          Meeting?
  paymentRequest   PaymentRequest?

  @@index([serviceRequestId])
  @@index([senderId])
  @@index([createdAt])
}

model Meeting {
  id                     String         @id @default(uuid())
  serviceRequestId       String
  messageId              String?        @unique
  scheduledAt            DateTime
  durationMinutes        Int            @default(30)
  meetingType            MeetingType    @default(ONLINE)
  locationOrUrl          String
  status                 MeetingStatus  @default(SCHEDULED)
  clientRescheduleReason String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  serviceRequest         ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  message                Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([serviceRequestId])
  @@index([scheduledAt])
  @@index([status])
}

model PaymentRequest {
  id               String         @id @default(uuid())
  serviceRequestId String
  messageId        String?        @unique
  amount           Float
  currency         String         @default("ETB")
  description      String
  paymentLink      String?
  bankDetails      String?        // JSON string (CBE, Telebirr, etc.)
  dueDate          DateTime?
  status           PaymentStatus  @default(AWAITING_PAYMENT)
  verifiedByUserId String?
  rejectionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  message          Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  verifiedBy       User?          @relation("VerifiedPayments", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  proofs           PaymentProof[]

  @@index([serviceRequestId])
  @@index([status])
}

model PaymentProof {
  id                  String         @id @default(uuid())
  paymentRequestId    String
  receiptAttachmentId String?        @unique
  referenceNumber     String?
  amountPaid          Float
  paymentMethod       String         // TELEBIRR, CBE_BIRR, CBE_TRANSFER, BANK_TRANSFER, OTHER
  paymentDate         DateTime       @default(now())
  notes               String?
  submittedAt         DateTime       @default(now())

  paymentRequest      PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  receiptAttachment   Attachment?    @relation(fields: [receiptAttachmentId], references: [id], onDelete: SetNull)

  @@index([paymentRequestId])
  @@index([referenceNumber])
}

model Feedback {
  id               String         @id @default(uuid())
  serviceRequestId String         @unique
  clientId         String
  rating           Int
  comment          String?
  isPublic         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  client           User           @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([rating])
}

model Notification {
  id               String           @id @default(uuid())
  userId           String
  title            String
  body             String
  type             NotificationType
  relatedRequestId String?
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model ChannelLink {
  id              String      @id @default(uuid())
  userId          String
  channelType     ChannelType
  channelUserId   String?
  channelUsername String?
  oneTimeCode     String?     @unique
  isVerified      Boolean     @default(false)
  linkedAt        DateTime?
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelType, channelUserId])
  @@index([userId])
}

model ReplyTemplate {
  id           String   @id @default(uuid())
  title        String
  category     String
  content      String
  placeholders String?  // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  details      String?  // JSON string
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model Setting {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String   // JSON string
  description     String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  @@index([key])
}

model AiLog {
  id               String   @id @default(uuid())
  serviceRequestId String?
  action           String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int      @default(0)
  success          Boolean  @default(true)
  error            String?
  createdAt        DateTime @default(now())

  @@index([serviceRequestId])
  @@index([createdAt])
}
