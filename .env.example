# =====================================================================
# Customer Request & Feedback Management System - Environment Variables
# =====================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
WEB_BASE_URL=http://localhost:5173

# Database (PostgreSQL via Prisma)
# In Docker: postgresql://postgres:postgres@db:5432/crm_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_db?schema=public

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long_123456
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long_654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_salt_for_signed_cookies_abcdef123456

# Super Admin Seed Account (Created automatically on first seed if not exists)
SUPER_ADMIN_NAME="System Super Admin"
SUPER_ADMIN_PHONE="+251911223344"
SUPER_ADMIN_EMAIL="admin@zacma.tech"
SUPER_ADMIN_PASSWORD="AdminSecurePassword123!"

# CORS Configuration (comma-separated origins allowed to make credentials-based requests)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Storage Configuration (local or s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Anthropic Claude API (AI Intelligence)
# Leave empty or set to test key; system falls back gracefully to smart heuristic engine
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Telegram Bot API
# Create bot via @BotFather on Telegram to obtain token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_custom_random_webhook_secret_string

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15

# Timezone Display
APP_TIMEZONE=Africa/Addis_Ababa
